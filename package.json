{
  "name": "dx-llp-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sass src/scss/pages/page-lp.scss:.build/page-lp/page-lp.css && sass --watch src/scss/pages/page-lp.scss:.build/page-lp/page-lp.css & vite build --watch --mode development & vite",
    "build": "vite build && sass --no-source-map src/scss/pages/page-lp.scss:dist/page-lp/page-lp.css",
    "preview": "vite preview",
    "sass:watch": "sass --watch src/scss/pages/page-lp.scss:.build/page-lp/page-lp.css",
    "js:watch": "vite build --watch --mode development",
    "wp-container:build": "bash scripts/install-cocoon.sh && docker compose up --build -d"
  },
  "devDependencies": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14"
    }
  },
  "dependencies": {
    "sass": "^1.93.3"
  }
}
